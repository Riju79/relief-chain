# ══════════════════════════════════════════════════════════════════
# ReliefChain Environment Configuration
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values after deployment.

# ── Sui Network ──────────────────────────────────────────────────
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
NETWORK=testnet

# ── Deployed Move Package (REQUIRED) ─────────────────────────────
# Deploy with: sui client publish --gas-budget 100000000 ./move
# Copy the Published Package ID from the output.
RELIEFCHAIN_PACKAGE_ID=

# ── Capability Object IDs (from deploy output) ──────────────────
# AdminCap object ID — granted to the deployer at publish time
ADMIN_CAP_OBJECT_ID=
# VerifierCap object ID — created via grant_verifier_role
VERIFIER_CAP_OBJECT_ID=

# ── Walrus Decentralized Storage ────────────────────────────────
WALRUS_PUBLISHER=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space

# ── Server ──────────────────────────────────────────────────────
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Indexer ─────────────────────────────────────────────────────
INDEXER_DB_PATH=indexer_db.json
INDEXER_POLL_INTERVAL_MS=5000
